# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 1000000
stop_time = 100.0

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic =  0  0  0
geometry.coord_sys   =  0       # 0 => cart
geometry.prob_lo     =  0    0    0 
geometry.prob_hi     =  1.0  0.5  1.0     # EB test case 2
amr.n_cell           =  64 32 64

# >>>>>>>>>>>>>  BC KEYWORDS <<<<<<<<<<<<<<<<<<<<<<
# Interior, UserBC, Symmetry, SlipWall, NoSlipWall
# >>>>>>>>>>>>>  BC KEYWORDS <<<<<<<<<<<<<<<<<<<<<<
pelec.lo_bc       =  "Symmetry" "SlipWall" "Symmetry"
pelec.hi_bc       =  "Symmetry" "SlipWall" "Symmetry"

# Problem setup
pelec.eb_boundary_T = 300.
pelec.eb_isothermal = 1
pelec.chem_integrator = 2
ode.implicit_solve = 1
ode.analytical_jacobian = 0
#cvode.solve_type = "GMRES"
cvode.solve_type = "dense"
pelec.redistribution_type = "StateRedist"

# Plasma variables
pelec.ion_bc_type = 1                   # ion BC type (0 -> weak efield BCs, 1 -> strong efield BCs)
pelec.zero_bc_grad = 1                  # attempt to impose 0 gradient BCs at all electrode surfaces for charged particles
pelec.secondary_em_coef = 0.05          # secondary electron emission coefficient
pelec.pulse_freq = 1000.0e3             # pulse frequency (Hz)
pelec.pulse_fwhm = 10.0e-9              # pulse FWHM (s)
pelec.pulse_peak = 12000.0e7            # peak potential of the driven electrode (erg/C)
pelec.pulse_timing = 10.0e-9            # timing of the first pulse peak (s) (not used for all pulse profiles)
pelec.pulse_num = 2                     # number of pulses
pelec.pulse_dt = 1.0e-11                # dt around each pulse (s)  (uses similar time step methodology as used in pacman)
ef.use_nonLinearSolve = 0               # Switch nonlinear solver for nE and phiV on/off
ef.sigmoid_pulse = 1                    # Use sigmoid pulse with rise time = fwhm
ef.pulse_delay = 2.0e-9                 # Sigmoid pulse delay time (s)
ef.pulse_rise = 2.0e-9                  # Sigmoid pulse rise time (s)
ef.pulse_plateau = 1.0e-9               # Sigmoid pulse plateau time (s)

# WHICH PHYSICS
pelec.do_hydro = 1                      # Include advective processes?
pelec.do_mol = 1                        # MOL instead of SDC, necessary when using EB
pelec.do_react = 1                      # Include reactions?
pelec.diffuse_temp = 1                  
pelec.diffuse_vel  = 1                  
pelec.diffuse_spec = 1
pelec.diffuse_enth = 1
ef.do_drift = 1                         # Include charged species drift?
pelec.zero_bc_flux = 0                  # overwrites ion_bc_type, sets species fluxes at electrodes to zero
ef.noSpaceCharge = 0                    # Solve Poisson problem for potential without space charge effects
ef.do_photoionization = 1               # Include photoionization?
ef.star_update = 0                      # Calculate intermediate electric fields using star states?
ef.semiImpEfield = 1                    # Use semi-impicit approach to calculate electric field?
ef.ion_rate_type = 1                    # Sets ionization model in photoionization code (0 -> updated Kossyi rates, 1 -> Morrow rates, 2 -> BOLSIG rates)
pelec.add_ext_src = 1                   # Include Joule heating effects?

# TRANSPORT (constant values consistent w E/N ~ 200 Td)
# ef.constEleTransport = 1        # Use constant electron mobility (and diffusivity, via Einsten relation)
# ef.eleMobility = 1.0e24         # Constant electron mobility*N to use (1/V-m-s)
# ef.eleDiffusivity = 4.0e24      # Constant electron diffusivity*N to use (1/m-s)

# TIME STEP CONTROL
pelec.dt_cutoff      = 5.e-20  # level 0 timestep below which we halt
pelec.cfl            = 0.27     # cfl number for hyperbolic system
pelec.init_shrink    = 0.8    # scale back initial timestep
pelec.change_max     = 1.05     # maximum increase in dt over successive steps
#pelec.fixed_dt = 2.0e-13
pelec.max_dt = 1.0e-11

# DIAGNOSTICS & VERBOSITY
pelec.sum_interval   = 1       # timesteps between computing mass
pelec.v              = 1       # verbosity in PeleC cpp files
amr.v                = 1       # verbosity in Amr.cpp
#amr.grid_log         = grdlog  # name of grid logging file

# REFINEMENT / REGRIDDING
amr.max_level       = 6       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = 2       # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 64 
amr.subcycling_mode = None

# TAGGING
tagging.efielderr = 1500
tagging.max_efield_lev = 10
tagging.negraderr = 1.0e-16
tagging.max_negrad_lev = 0
tagging.efieldgraderr = 100.0
tagging.max_efieldgrad_lev = 10
tagging.max_vfracerr_lev = 8
tagging.plasma_channel_lev = 3
tagging.plasma_channel_bottom = 0.125
tagging.plasma_channel_top = 0.375

# CHECKPOINT FILES
amr.checkpoint_files_output = 1         # Turn check files on/off
amr.check_file      = /PATH/TO/chk      # root name of checkpoint file
#amr.check_int       = 1000       # number of timesteps between checkpoints
amr.check_per       = 1.0e-9       # amount of time between checkpoints

# PLOTFILES
amr.plot_files_output = 1               # Turn plotfiles on/off
amr.plot_file       = /PATH/TO/plt      # root name of plotfiles
#amr.plot_int        = 100              # number of timesteps between plotfiles
amr.plot_per        = 1.0e-10           # amount of time between plotfiles
amr.derive_plot_vars = pressure         # List of derived variables to plot (as opposed to conserved variables, like momentum, species mass densities etc.)
amr.plot_vars  =  density Temp rho_E phiV nE Efieldx Efieldy Efieldz    # List of conserved variables to plot
pelec.plot_massfrac = false 
pelec.plot_vfrac = true
pelec.plot_rhoy = false
ef.plot_numdens = true
pelec.monitor_file = true               # Turn on/off plasma monitor file

# Parabolic pin-to-pin geometry
eb2.use_eb2 = 1
eb2.geom_type = pins
pins.num_pin = 2
pins.pin_0_tip = 1.0 0.125 1.0
pins.pin_1_tip = 1.0 0.375 1.0
pins.pin_0_c = -100.0
pins.pin_1_c = 100.0
pins.pin_0_dir = 1
pins.pin_1_dir = 1
ebd.boundary_grad_stencil_type = 0

# Cylindrical pin-to-pin geometry
# eb2.use_eb2 = 1
# eb2.geom_type = cylinder_pins
# cylinder_pins.num_pin = 2
# cylinder_pins.pin_0_center = 0.25 0.0 0.25     # Cathode
# cylinder_pins.pin_1_center = 0.25 0.5 0.25      # Anode
# cylinder_pins.pin_0_radius = 0.005
# cylinder_pins.pin_1_radius = 0.005
# cylinder_pins.pin_0_height = 0.19
# cylinder_pins.pin_1_height = 0.19
# cylinder_pins.pin_0_dir = 1
# cylinder_pins.pin_1_dir = 1
# cylinder_pins.pin_0_sign = 1
# cylinder_pins.pin_1_sign = -1
# ebd.boundary_grad_stencil_type = 0

# Truncated cone pin-to-pin geometry
# eb2.use_eb2 = 1
# eb2.geom_type = sandia_pins
# sandia_pins.num_pin = 2
# sandia_pins.pin_1_base = 0.25 -0.12 0.25     # Cathode
# sandia_pins.pin_0_base = 0.25 0.52 0.25      # Anode
# sandia_pins.pin_1_radius1 = 0.068
# sandia_pins.pin_1_radius2 = 0.005
# sandia_pins.pin_0_radius1 = 0.073
# sandia_pins.pin_0_radius2 = 0.005
# sandia_pins.pin_1_height = 0.22
# sandia_pins.pin_0_height = 0.12
# sandia_pins.pin_1_dir = 1
# sandia_pins.pin_0_dir = 1
# ebd.boundary_grad_stencil_type = 0

# Initial thermodynamic conditions, just make sure pressure and density are what you want
prob.p = 1013250.0
prob.rho = 0.0011719
prob.vx_in =  0.0
prob.vy_in =  0.0
prob.Re_L = 1.0
prob.Pr = 0.7
prob.phiV_bottom = 12231.e7

#fabarray.mfiter_tile_size = 1024 1024 1024
amrex.fpe_trap_invalid = 1
amrex.fpe_trap_zero = 1
amrex.fpe_trap_overflow = 1

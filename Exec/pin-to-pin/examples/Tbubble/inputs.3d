#pelec.init_pltfile = /scratch1/07638/aduarteg/PeleScratch/hypersonic-simulations/atm-experiment-5L/plt42707
#pelec.init_pltfile_massfrac_tol = 1e-2
amr.restart = /scratch1/07638/aduarteg/PeleScratch/hypersonic-simulations/atm-experiment-5L/chk42707 
#amr.restart = chk42800 
#eb2.geom_type="chkfile"
#eb2.chkfile="/scratch1/07638/aduarteg/PeleScratch/hypersonic-simulations/atm-experiment-5L/chk_geom" # optional, defaults to "chk_geom"

#
eb2.use_eb2 = 1
eb2.geom_type = cylinder_pins
cylinder_pins.num_pin = 2
cylinder_pins.pin_0_center = 1.0 0.0 1.0     # Cathode
cylinder_pins.pin_1_center = 1.0 0.5 1.0      # Anode
cylinder_pins.pin_0_radius = 0.025
cylinder_pins.pin_1_radius = 0.025
cylinder_pins.pin_0_height = 0.2
cylinder_pins.pin_1_height = 0.2
cylinder_pins.pin_0_dir = 1
cylinder_pins.pin_1_dir = 1
cylinder_pins.pin_0_sign = 1
cylinder_pins.pin_1_sign = -1
ebd.boundary_grad_stencil_type = 0

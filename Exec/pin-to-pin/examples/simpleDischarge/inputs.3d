# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 5000
stop_time = 10.0e-6

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic =  0  0  0
geometry.coord_sys   =  0       # 0 => cart
geometry.prob_lo     =  0.0  0.0    0.0 
geometry.prob_hi     =  0.5  0.5  0.5     # EB test case 2
amr.n_cell           =  32 32 32

# >>>>>>>>>>>>>  BC KEYWORDS <<<<<<<<<<<<<<<<<<<<<<
# Interior, UserBC, Symmetry, SlipWall, NoSlipWall
# >>>>>>>>>>>>>  BC KEYWORDS <<<<<<<<<<<<<<<<<<<<<<

pelec.lo_bc       =  "Symmetry" "Symmetry" "Symmetry"
pelec.hi_bc       =  "FOExtrap" "FOExtrap" "FOExtrap"

# Problem setup
pelec.eb_boundary_T = 300.
pelec.eb_isothermal = 1
pelec.eb_noslip = 1
pelec.chem_integrator = "ReactorCvode"
ode.implicit_solve = 1
ode.analytical_jacobian = 0
cvode.solve_type = "GMRES"
pelec.redistribution_type = "StateRedist"
pelec.allow_negative_energy = 1
pelec.allow_small_energy = 1
ode.rtol = 1.0e-5
ode.atol = 1.0e-6

# Initial thermo conditions (make sure rho and p are consistent with T you want)
prob.p = 1013250.0 
prob.T = 300.0 
prob.vx_in =  0.0
prob.vy_in =  0.0
prob.r0 = 200e-4 
prob.Ld = 0.25 
prob.y0 = 0.0
prob.sigma0 = 25.0e-4 
prob.Erho = 2000.0 


# Plasma variables
pelec.ion_bc_type = 1             # ion BC type (0 -> weak efield BCs, 1 -> strong efield BCs)
pelec.zero_bc_grad = 1            # attempt to impose 0 gradient BCs at all electrode surfaces for charged particles
pelec.secondary_em_coef = 0.05    # secondary electron emission coefficient
pelec.pulse_freq = 1000.0e3            # pulse frequency (Hz)
pelec.pulse_fwhm = 10.0e-9             # pulse FWHM (s)
pelec.pulse_peak = 0.0e7        # peak potential of the driven electrode (erg/C)
#pelec.pulse_peak = 0.0        # peak potential of the driven electrode (erg/C)
pelec.pulse_timing = 10.0e-9          # timing of the first pulse peak (s)
pelec.pulse_num = 0              # number of pulses
pelec.pulse_dt = 1.0e-8         # dt around each pulse (s)
ef.use_nonLinearSolve = 0       
ef.sigmoid_pulse = 1         # Use sigmoid pulse with rise time = fwhm
ef.pulse_delay = 2.0e-9
ef.pulse_rise = 2.0e-9
ef.pulse_plateau = 1.0e-9

# WHICH PHYSICS
pelec.do_hydro = 1
pelec.do_mol = 1
pelec.do_react = 0
pelec.diffuse_temp = 0
pelec.diffuse_vel  = 0
pelec.diffuse_spec = 0
pelec.diffuse_enth = 0
pelec.initial_dt = 0.1e-9
ef.do_drift = 0
pelec.zero_bc_flux = 0          # overwrites ion_bc_type, sets species fluxes at electrodes to zero
ef.noSpaceCharge = 0             # Solve Poisson problem without space charge effects
ef.do_photoionization = 0
ef.star_update = 0
ef.semiImpEfield = 0
ef.ion_rate_type = 1
pelec.add_ext_src = 1           # turns on joule heating
ef.relax_eleDiff = 0
ef.solve_efield = 0
ef.use_nEDiffImp = 0

# TRANSPORT (constant values consistent w E/N ~ 200 Td)
# ef.constEleTransport = 1        # Use constant electron mobility (and diffusivity, via Einsten relation)
# ef.eleMobility = 1.0e24         # Constant electron mobility*N to use (1/V-m-s)
# ef.eleDiffusivity = 4.0e24      # Constant electron diffusivity*N to use (1/m-s)

# TIME STEP CONTROL
pelec.dt_cutoff      = 5.e-20  # level 0 timestep below which we halt
pelec.cfl            = 0.27     # cfl number for hyperbolic system
pelec.init_shrink    = 0.8    # scale back initial timestep
pelec.change_max     = 1.05     # maximum increase in dt over successive steps
#pelec.fixed_dt = 1.0e-10
pelec.max_dt = 1.0e-6

# DIAGNOSTICS & VERBOSITY
pelec.sum_interval   = 1       # timesteps between computing mass
pelec.v              = 1       # verbosity in PeleC cpp files
amr.v                = 1       # erbosity in Amr.cpp
#amr.grid_log         = grdlog  # name of grid logging file

# REFINEMENT / REGRIDDING
amr.max_level       = 3       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 2 # refinement ratio
amr.regrid_int      = 2       # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 64 
amr.subcycling_mode = None

# TAGGING
#tagging.efielderr = 1500
#tagging.max_efield_lev = 0
#tagging.negraderr = 1.0e-23
#tagging.max_negrad_lev = 0
#tagging.efieldgraderr = 100.0
#tagging.max_efieldgrad_lev = 0
tagging.tempgrad = 75.0
tagging.max_tempgrad_lev = 10
tagging.pressgrad = 0.2e5
tagging.max_pressgrad_lev = 3
tagging.max_vfracerr_lev = 0
tagging.plasma_channel_lev = 3
tagging.plasma_channel_bottom = 0.0
tagging.plasma_channel_top = 0.38
tagging.plasma_channel_rmax = 0.1
tagging.plasma_channel_r0 = 0.0

tagging.refinement_indicators = yLow
tagging.yLow.max_level=3
tagging.yLow.in_box_lo = 0.0  0.0  0.0
tagging.yLow.in_box_hi = 0.1  0.2   0.1



# CHECKPOINT FILES
amr.checkpoint_files_output = 1
amr.check_file      = chk      # root name of checkpoint file
amr.check_int       = 2000       # number of timesteps between checkpoints
#amr.check_per       = 1.0e-8       # amount of time between checkpoints

# PLOTFILES
amr.plot_files_output = 1
amr.plot_file       = plt
#amr.plot_int        = 100
#amr.plot_int        = 20
amr.plot_per = 170.0e-9 
amr.derive_plot_vars = pressure x_velocity y_velocity z_velocity mag_vort MachNumber magvel
amr.plot_vars  =  density Temp rho_E rho_e
pelec.plot_massfrac = false
pelec.plot_vfrac = true
pelec.plot_rhoy = false
ef.plot_numdens = true
pelec.monitor_file = true
ef.pac_mechanism = 2          # 1 for original PAC mechanism, 2 for PAC mechanism with negative ions

# Parabolic pin-to-pin geometry
# eb2.use_eb2 = 1
# eb2.geom_type = pins
# pins.num_pin = 2
# pins.pin_0_tip = 1.0 0.125 1.0
# pins.pin_1_tip = 1.0 0.375 1.0
# pins.pin_0_c = -100.0
# pins.pin_1_c = 100.0
# pins.pin_0_dir = 1
# pins.pin_1_dir = 1
# ebd.boundary_grad_stencil_type = 0

eb2.use_eb2 = 1
eb2.geom_type = all_regular
#eb2.geom_type = pins
eb2.small_volfrac = 1.e-4
pins.num_pin = 2
pins.pin_0_tip = 0.0 -0.125 0.0
pins.pin_1_tip = 0.0 0.125 0.0
pins.pin_0_c = -20.0
pins.pin_1_c = 20.0
pins.pin_0_dir = 1
pins.pin_1_dir = 1
pins.pin_rmax = 0.1
tagging.max_eb_refine_lev = 5


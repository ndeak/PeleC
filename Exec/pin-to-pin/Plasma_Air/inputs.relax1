# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 5000000
stop_time = 5.0e-6

# PROBLEM SIZE & GEOMETRY
#geometry.is_periodic =  0  0  0
geometry.is_periodic =  0  0  0
geometry.coord_sys   =  0       # 0 => cart
geometry.prob_lo     =  0    0    0 
geometry.prob_hi     =  1.0  0.5  1.0     # EB test case 2
amr.n_cell           =  64 32 64

# >>>>>>>>>>>>>  BC KEYWORDS <<<<<<<<<<<<<<<<<<<<<<
# Interior, UserBC, Symmetry, SlipWall, NoSlipWall
# >>>>>>>>>>>>>  BC KEYWORDS <<<<<<<<<<<<<<<<<<<<<<

#pelec.lo_bc       =  "Interior" "SlipWall" "Interior"
#pelec.hi_bc       =  "Interior" "SlipWall" "Interior"
pelec.lo_bc       =  "Symmetry" "SlipWall" "Symmetry"
pelec.hi_bc       =  "Symmetry" "SlipWall" "Symmetry"
#pelec.lo_bc       =  "Symmetry" "Symmetry" "Symmetry"
#pelec.hi_bc       =  "Symmetry" "Symmetry" "Symmetry"

# Problem setup
pelec.eb_boundary_T = 300.
pelec.eb_isothermal = 0
pelec.chem_integrator = "ReactorCvode"
ode.implicit_solve = 1
#ode.iverbose = 4
ode.analytical_jacobian = 0
#cvode.solve_type = "dense_direct"
cvode.solve_type = "GMRES"
pelec.redistribution_type = "StateRedist"
pelec.allow_negative_energy = 1
pelec.allow_small_energy = 1
ode.rtol = 1.0e-6                     # Relative tolerance of the chemical solve
ode.atol = 1.0e-5                     # Absolute tolerance factor applied on typical values
cvode.max_order  = 4                  # CVODE max BDF order.
#cvode.solve_type = "GMRES"

# Initial thermo conditions (make sure rho and p are consistent with T you want)
prob.p = 1013250.0
prob.T = 300
prob.vx_in =  0.0
prob.vy_in =  0.0

# Plasma variables
pelec.ion_bc_type = 1             # ion BC type (0 -> weak efield BCs, 1 -> strong efield BCs)
pelec.zero_bc_grad = 1            # attempt to impose 0 gradient BCs at all electrode surfaces for charged particles
pelec.secondary_em_coef = 0.05    # secondary electron emission coefficient
pelec.pulse_freq = 100.0e3            # pulse frequency (Hz)
pelec.pulse_fwhm = 10.0e-9             # pulse FWHM (s)
pelec.pulse_peak = 00000.0e7        # peak potential of the driven electrode (erg/C)
pelec.pulse_timing = -100.0e-9          # timing of the first pulse peak (s)
pelec.pulse_num = 1              # number of pulses
pelec.pulse_dt = 1.0e-9         # dt around each pulse (s)
ef.use_nonLinearSolve = 0       
ef.sigmoid_pulse = 1         # Use sigmoid pulse with rise time = fwhm
ef.pulse_delay = 2.0e-9
ef.pulse_rise = 2.0e-9
ef.pulse_plateau = 10.0e-9

## ENERGY LIMITER
ef.energy_limiter = 0
ef.energy_zero = -495612.9786 
ef.energy_max = 125.0
ef.C_dielectric = 50.0

# WHICH PHYSICS
pelec.do_hydro = 1
pelec.do_mol = 1
pelec.do_react = 1
pelec.diffuse_temp = 1
pelec.diffuse_vel  = 1
pelec.diffuse_spec = 1
pelec.diffuse_enth = 1
ef.do_drift = 1
pelec.zero_bc_flux = 0          # overwrites ion_bc_type, sets species fluxes at electrodes to zero
ef.noSpaceCharge = 0             # Solve Poisson problem without space charge effects
ef.do_photoionization = 0
ef.star_update = 0
ef.semiImpEfield = 1
ef.ion_rate_type = 1
pelec.add_ext_src = 1           # turns on joule heating
ef.relax_eleDiff = 0
ef.use_nEDiffImp = 0

# TRANSPORT (constant values consistent w E/N ~ 200 Td)
# ef.constEleTransport = 1        # Use constant electron mobility (and diffusivity, via Einsten relation)
# ef.eleMobility = 1.0e24         # Constant electron mobility*N to use (1/V-m-s)
# ef.eleDiffusivity = 4.0e24      # Constant electron diffusivity*N to use (1/m-s)

# TIME STEP CONTROL
pelec.dt_cutoff      = 5.e-20  # level 0 timestep below which we halt
pelec.cfl            = 0.27     # cfl number for hyperbolic system
pelec.init_shrink    = 0.8    # scale back initial timestep
pelec.change_max     = 1.05     # maximum increase in dt over successive steps
#pelec.fixed_dt = 1.0e-11
pelec.max_dt = 1.0e-10

# DIAGNOSTICS & VERBOSITY
pelec.sum_interval   = 1       # timesteps between computing mass
pelec.v              = 1       # verbosity in PeleC cpp files
amr.v                = 1       # verbosity in Amr.cpp
#amr.grid_log         = grdlog  # name of grid logging file

# REFINEMENT / REGRIDDING
amr.max_level       = 4       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 2 # refinement ratio
amr.regrid_int      = 2       # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 64 
amr.subcycling_mode = None

# TAGGING
tagging.efielderr = 10.0
tagging.max_efield_lev = 3
tagging.negraderr = 1.0e-16
tagging.max_negrad_lev = 2
tagging.efieldgraderr = 2.5
tagging.max_efieldgrad_lev = 10

tagging.max_ne_lev = 3 
tagging.neerr = 1.0e10
tagging.max_o4grad_lev = 0 
tagging.max_Telegrad_lev = 0 
tagging.max_Tele_lev = 0

tagging.tempgrad = 10.0
tagging.max_tempgrad_lev = 4
tagging.pressgrad = 1.0e5
tagging.max_pressgrad_lev = 3
tagging.max_vfracerr_lev = 5
tagging.vfrac_coarse = 5
#tagging.vfrac_top = 0.45
#tagging.vfrac_bottom = 0.05
tagging.plasma_channel_lev = 2
tagging.plasma_channel_bottom = 0.1
tagging.plasma_channel_top = 0.4
tagging.plasma_channel_rmax = 0.1

# CHECKPOINT FILES
amr.checkpoint_files_output = 1
amr.check_file      = /scratch1/07638/aduarteg/PeleScratch/PlasmaAir_relax1/chk      # root name of checkpoint file
#amr.restart = /scratch1/07638/aduarteg/PeleScratch/atm-TwoT-XX/chk15276      # root name of checkpoint file
amr.check_int       = 100       # number of timesteps between checkpoints
#amr.check_per       = 0.1e-9       # amount of time between checkpoints
amr.restart = /scratch1/07638/aduarteg/PeleScratch/PlasmaAir_test/chk04162      # root name of checkpoint file

# PLOTFILES
amr.plot_files_output = 1
amr.plot_file       = /scratch1/07638/aduarteg/PeleScratch/PlasmaAir_relax1/plt
amr.plot_int        = 100
#amr.plot_per        = 0.1e-9
amr.derive_plot_vars = pressure
amr.plot_vars  =  density Temp rho_E rho_e phiV nE Efieldx Efieldy Efieldz
pelec.plot_massfrac = false
pelec.plot_vfrac = true
pelec.plot_rhoy = false
ef.plot_numdens = true
pelec.monitor_file = false
ef.pac_mechanism = 0          # 0 for air, 1 for original PAC mechanism, 2 for PAC mechanism with negative ions

# Parabolic pin-to-pin geometry
eb2.use_eb2 = 1
eb2.geom_type = cylinder_pins
eb2.small_volfrac = 1.e-4
cylinder_pins.num_pin = 2
cylinder_pins.pin_0_center = 1.0 0.0 1.0     # Cathode
cylinder_pins.pin_1_center = 1.0 0.5 1.0      # Anode
cylinder_pins.pin_0_radius = 0.025
cylinder_pins.pin_1_radius = 0.025
cylinder_pins.pin_0_height = 0.2
cylinder_pins.pin_1_height = 0.2
cylinder_pins.pin_0_dir = 1
cylinder_pins.pin_1_dir = 1
cylinder_pins.pin_0_sign = 1
cylinder_pins.pin_1_sign = -1
ebd.boundary_grad_stencil_type = 0
eb2.max_level_generation = 4

#fabarray.mfiter_tile_size = 1024 1024 1024
#amrex.fpe_trap_invalid = 1
#amrex.fpe_trap_zero = 1
#amrex.fpe_trap_overflow = 1
